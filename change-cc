#!/bin/bash
# change-cc - Switch Claude Code models and settings in settings.json
# Usage: change-cc [model] | change-cc [options]

# NOTE: no `set -e` here — this is an interactive menu script.
# With `set -e`, a failed `ls` (no backups found) or unexpected input
# kills the whole script silently. Errors are handled explicitly instead.
set -u

# Configuration
SETTINGS_FILE="$HOME/.claude/settings.json"
SCRIPT_NAME="change-cc"
INSTALL_DIR="$HOME/.local/bin"
SCRIPT_PATH="$INSTALL_DIR/$SCRIPT_NAME"

# Global state
BACKUPS=()
CHOICE=""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# Standard fixed model variants (guaranteed fixed order across all menus)
STANDARD_MODELS=(
    "ANTHROPIC_MODEL:Default Model"
    "ANTHROPIC_SMALL_FAST_MODEL:Small/Fast Model"
    "ANTHROPIC_DEFAULT_OPUS_MODEL:Opus Model"
    "ANTHROPIC_DEFAULT_SONNET_MODEL:Sonnet Model"
    "ANTHROPIC_DEFAULT_HAIKU_MODEL:Haiku Model"
    "ANTHROPIC_DEFAULT_FABLE_MODEL:Fable Model"
)

# Print colored output
print_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $*"; }
print_error() { echo -e "${RED}[ERROR]${NC} $*"; }
print_header() { echo -e "${CYAN}$*${NC}"; }
print_option() { echo -e "${MAGENTA}$*${NC}"; }

# Validate jq is installed
check_jq() {
    if ! command -v jq &>/dev/null; then
        print_error "jq is not installed. This script requires jq for JSON processing."
        print_info "Install it with:"
        print_info "  Ubuntu/Debian:  sudo apt update && sudo apt install jq"
        print_info "  Fedora/RHEL:    sudo dnf install jq"
        print_info "  Arch:           sudo pacman -S jq"
        print_info "  macOS:          brew install jq"
        print_info "  Alpine:         apk add jq"
        exit 1
    fi
}

# Check if settings.json exists, auto-initialize directory and file if missing
check_settings_file() {
    local claude_dir
    claude_dir="$(dirname "$SETTINGS_FILE")"
    if [[ ! -d "$claude_dir" ]]; then
        mkdir -p "$claude_dir"
    fi

    if [[ ! -f "$SETTINGS_FILE" ]]; then
        print_warning "Settings file not found: $SETTINGS_FILE"
        print_info "Creating default $SETTINGS_FILE..."
        cat << 'INITEOF' > "$SETTINGS_FILE"
{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "ANTHROPIC_MODEL": "anthropic/claude-sonnet",
    "ANTHROPIC_SMALL_FAST_MODEL": "anthropic/claude-haiku",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "anthropic/claude-opus",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "anthropic/claude-sonnet",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "anthropic/claude-haiku",
    "ANTHROPIC_AUTH_TOKEN": ""
  },
  "model": "haiku",
  "effortLevel": "high",
  "theme": "dark"
}
INITEOF
        print_success "Created initial settings.json"
    fi
}

# Create backup of settings
create_backup() {
    if [[ -f "$SETTINGS_FILE" ]]; then
        local claude_dir
        claude_dir="$(dirname "$SETTINGS_FILE")"
        cp "$SETTINGS_FILE" "$claude_dir/settings.json.backup.$(date +%Y%m%d_%H%M%S)"
    fi
}

# Get current value from settings (top-level)
get_value() {
    local key="$1"
    jq -r --arg k "$key" '.[$k] // ""' "$SETTINGS_FILE" 2>/dev/null || echo ""
}

# Get env value (.env object)
get_env_value() {
    local key="$1"
    jq -r --arg k "$key" '.env[$k] // ""' "$SETTINGS_FILE" 2>/dev/null || echo ""
}

# Safe token masking without eval
mask_token() {
    local token="$1"
    if [[ ${#token} -gt 3 ]]; then
        local prefix="${token:0:3}"
        local rest_len=$(( ${#token} - 3 ))
        local masked_rest
        masked_rest=$(printf '%*s' "$rest_len" '' | tr ' ' 'x')
        echo "${prefix}${masked_rest}"
    elif [[ -n "$token" ]]; then
        echo "***"
    else
        echo "(not set)"
    fi
}

# Update a top-level field
update_field() {
    local field="$1"
    local value="$2"
    create_backup
    jq --arg f "$field" --arg val "$value" '.[$f] = $val' "$SETTINGS_FILE" > "$SETTINGS_FILE.tmp" && mv "$SETTINGS_FILE.tmp" "$SETTINGS_FILE"
    print_success "Updated $field to: $value"
}

# Update an env field (safely ensures .env object exists)
update_env() {
    local key="$1"
    local value="$2"
    create_backup
    jq --arg k "$key" --arg v "$value" '
        (if .env == null or (.env | type) != "object" then .env = {} else . end) | .env[$k] = $v
    ' "$SETTINGS_FILE" > "$SETTINGS_FILE.tmp" && mv "$SETTINGS_FILE.tmp" "$SETTINGS_FILE"
    print_success "Updated $key to: $value"
}

# Get all model variants in guaranteed fixed order (Standard 1-6 + any custom _MODEL in .env)
# Outputs lines of: KEY|LABEL|VALUE
get_all_model_variants() {
    local seen_keys=()

    # 1. Standard predefined models in strict fixed order
    for entry in "${STANDARD_MODELS[@]}"; do
        IFS=':' read -r k label <<< "$entry"
        local val
        val=$(get_env_value "$k")
        echo "$k|$label|$val"
        seen_keys+=("$k")
    done

    # 2. Dynamically scan for any extra custom _MODEL keys in .env
    local custom_entries
    custom_entries=$(jq -r '.env | if . != null and (. | type == "object") then to_entries[] | select(.key | endswith("_MODEL")) | "\(.key)|\(.value)" else empty end' "$SETTINGS_FILE" 2>/dev/null || true)

    if [[ -n "$custom_entries" ]]; then
        while IFS='|' read -r k val; do
            [[ -z "$k" ]] && continue
            local already_seen=0
            for seen in "${seen_keys[@]}"; do
                if [[ "$seen" == "$k" ]]; then
                    already_seen=1
                    break
                fi
            done
            if [[ $already_seen -eq 0 ]]; then
                echo "$k|Custom Model ($k)|$val"
                seen_keys+=("$k")
            fi
        done <<< "$custom_entries"
    fi
}

# Show current configuration
show_current_config() {
    print_header "╔══════════════════════════════════════════════════════════════╗"
    print_header "║           Current Claude Code Configuration                 ║"
    print_header "╚══════════════════════════════════════════════════════════════╝"
    echo ""

    local base_url
    base_url=$(get_env_value "ANTHROPIC_BASE_URL")
    local auth_token
    auth_token=$(get_env_value "ANTHROPIC_AUTH_TOKEN")
    if [[ -z "$auth_token" ]]; then
        auth_token=$(get_env_value "ANTHROPIC_API_KEY")
    fi
    local model_field
    model_field=$(get_value "model")
    local effort_level
    effort_level=$(get_value "effortLevel")
    local theme
    theme=$(get_value "theme")

    print_option "🌐 Base URL (ANTHROPIC_BASE_URL):   ${GREEN}${base_url:-(not set)}${NC}"
    print_option "🔑 Auth Token:                      ${GREEN}$(mask_token "$auth_token")${NC}"
    print_option "🤖 Main Model (model field):        ${GREEN}${model_field:-(not set)}${NC}"
    if [[ -n "$effort_level" ]]; then
        print_option "⚡ Effort Level:                    ${GREEN}${effort_level}${NC}"
    fi
    if [[ -n "$theme" ]]; then
        print_option "🎨 Theme:                           ${GREEN}${theme}${NC}"
    fi
    echo ""

    print_header "Model Variants:"
    while IFS='|' read -r key label val; do
        [[ -z "$key" ]] && continue
        local display_val="$val"
        if [[ -z "$display_val" ]]; then
            display_val="(not set)"
        fi
        printf "  ${MAGENTA}%-30s${NC} = ${GREEN}%s${NC}\n" "$label" "$display_val"
    done < <(get_all_model_variants)
    echo ""
}

# Change endpoint URL
change_endpoint() {
    print_header "═══ Change Endpoint URL (ANTHROPIC_BASE_URL) ═══"
    local current
    current=$(get_env_value "ANTHROPIC_BASE_URL")
    print_option "Current: ${current:-(not set)}"
    echo ""
    print_option "Options:"
    echo "  1) Use current from settings.json (${current:-none})"
    echo "  2) https://api.anthropic.com (official Anthropic)"
    echo "  3) Custom URL"
    echo "  0) Exit"
    echo ""
    read_choice "Select [0-3]: " 0 3

    case "$CHOICE" in
        1)
            if [[ -n "$current" ]]; then
                update_env "ANTHROPIC_BASE_URL" "$current"
            fi
            ;;
        2) update_env "ANTHROPIC_BASE_URL" "https://api.anthropic.com" ;;
        3)
            read -r -p "Enter custom URL: " custom_url
            if [[ -n "$custom_url" ]]; then
                update_env "ANTHROPIC_BASE_URL" "$custom_url"
            fi
            ;;
        0) print_info "Exit" ;;
    esac
    return 0
}

# Change API Key
change_auth_token() {
    print_header "═══ Change API Key (ANTHROPIC_AUTH_TOKEN) ═══"
    local current
    current=$(get_env_value "ANTHROPIC_AUTH_TOKEN")
    if [[ -z "$current" ]]; then
        current=$(get_env_value "ANTHROPIC_API_KEY")
    fi
    print_option "Current: $(mask_token "$current") (${#current} chars)"
    echo ""

    print_option "Enter new API key (input hidden): "
    local new_key=""
    if read -s -r new_key; then
        echo ""
        if [[ -n "$new_key" ]]; then
            printf '%*s\n' "${#new_key}" '' | tr ' ' '*'
            update_env "ANTHROPIC_AUTH_TOKEN" "$new_key"
        else
            print_warning "No key entered, skipping"
        fi
    else
        echo ""
        print_warning "No key entered, skipping"
    fi
}

# Helper: format tokens to human readable (k/m)
format_tokens() {
    local tokens="$1"
    if [[ $tokens -ge 1000000 ]]; then
        echo "$(( tokens / 1000000 ))m"
    elif [[ $tokens -ge 1000 ]]; then
        echo "$(( tokens / 1000 ))k"
    else
        echo "$tokens"
    fi
}

# Helper: parse human readable to tokens (supports k, m suffixes)
parse_tokens() {
    local input="$1"
    if [[ "$input" =~ ^([0-9]+)([kmKM])?$ ]]; then
        local num="${BASH_REMATCH[1]}"
        local suffix="${BASH_REMATCH[2]:-}"
        suffix="$(echo "$suffix" | tr '[:upper:]' '[:lower:]')"
        case "$suffix" in
            k) echo $(( num * 1000 )) ;;
            m) echo $(( num * 1000000 )) ;;
            "") echo "$num" ;;
        esac
    else
        echo ""
    fi
}

# Extract model name and context from value
# Returns: model_name|context_str
extract_model_context() {
    local value="$1"
    if [[ "$value" =~ ^(.+)\[([0-9]+[kmKM]?)\]$ ]]; then
        echo "${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"
    else
        echo "$value|"
    fi
}

# Change context for model variants
change_model_context() {
    while true; do
        print_header "═══ Change Model Variant Context ═══"
        echo ""
        print_info "Select which model variant to add/change context (Guaranteed Fixed Order):"
        echo ""

        local variant_keys=()
        local variant_labels=()
        local variant_values=()

        while IFS='|' read -r key label val; do
            [[ -z "$key" ]] && continue
            variant_keys+=("$key")
            variant_labels+=("$label")
            variant_values+=("$val")
        done < <(get_all_model_variants)

        for i in "${!variant_keys[@]}"; do
            local display_val="${variant_values[i]}"
            if [[ -z "$display_val" ]]; then
                display_val="(not set)"
            fi
            printf "  ${YELLOW}%2d)${NC} %-30s = ${GREEN}%s${NC}\n" $((i+1)) "${variant_labels[i]} (${variant_keys[i]})" "$display_val"
        done

        local base_count=${#variant_keys[@]}
        printf "  ${RED}%2d)${NC}  Back to main menu\n" 0
        echo ""

        read_choice "Select variant [0-$base_count]: " 0 $base_count
        local choice=$CHOICE

        [[ $choice -eq 0 ]] && return 0

        local variant_key="${variant_keys[$((choice-1))]}"
        local current_value="${variant_values[$((choice-1))]}"
        local variant_label="${variant_labels[$((choice-1))]}"

        echo ""
        print_header "═══ Change Context for $variant_label ($variant_key) ═══"
        echo ""
        print_info "Current value: ${current_value:-(not set)}"
        echo ""

        local extracted
        extracted=$(extract_model_context "$current_value")
        local current_model=""
        local current_context_str=""
        IFS='|' read -r current_model current_context_str <<< "$extracted"

        if [[ -n "$current_context_str" ]]; then
            local current_tokens
            current_tokens=$(parse_tokens "$current_context_str")
            print_info "Current context: [$current_context_str] = $current_tokens tokens"
        else
            print_info "Current context: (none - using model default)"
        fi
        echo ""

        local contexts=(
            "4k:4k"
            "8k:8k"
            "16k:16k"
            "32k:32k"
            "64k:64k"
            "128k:128k"
            "200k:200k"
            "500k:500k"
            "1m:1m"
            "2m:2m"
        )
        local ctx_len=${#contexts[@]}
        local custom_opt=$(( ctx_len + 1 ))
        local remove_opt=$(( ctx_len + 2 ))
        local change_name_opt=$(( ctx_len + 3 ))

        print_option "Select context suffix for model: ${current_model:-(enter model name first)}"
        for i in "${!contexts[@]}"; do
            IFS=':' read -r label tokens <<< "${contexts[i]}"
            local marker=""
            [[ "$label" == "$current_context_str" ]] && marker=" ${GREEN}← current${NC}"
            printf "  ${YELLOW}%2d)${NC}  [%-6s] (%s tokens)%s\n" $((i+1)) "$label" "$tokens" "$marker"
        done

        printf "  ${YELLOW}%2d)${NC}  Custom context (e.g., 500k, 1m)\n" $custom_opt
        printf "  ${YELLOW}%2d)${NC}  Remove context (use model default)\n" $remove_opt
        printf "  ${YELLOW}%2d)${NC}  Change model name (keep current context)\n" $change_name_opt
        printf "  ${RED}%2d)${NC}  Back to variant selection\n" 0
        echo ""

        read_choice "Select option [0-$change_name_opt]: " 0 $change_name_opt
        local opt_choice=$CHOICE

        [[ $opt_choice -eq 0 ]] && { echo ""; continue; }

        local new_value=""
        local model_to_use="$current_model"

        if [[ $opt_choice -le $ctx_len ]]; then
            IFS=':' read -r context_label _ <<< "${contexts[$((opt_choice-1))]}"
            if [[ -z "$model_to_use" ]]; then
                read -r -p "No model name set. Enter model name first: " model_to_use
                [[ -z "$model_to_use" ]] && { print_warning "No model name entered, skipping"; continue; }
            fi
            new_value="${model_to_use}[$context_label]"
        elif [[ $opt_choice -eq $custom_opt ]]; then
            if [[ -z "$model_to_use" ]]; then
                read -r -p "No model name set. Enter model name first: " model_to_use
                [[ -z "$model_to_use" ]] && { print_warning "No model name entered, skipping"; continue; }
            fi
            read -r -p "Enter custom context (e.g., 500k, 1m): " custom_context
            [[ -z "$custom_context" ]] && { print_warning "No value entered, skipping"; continue; }
            local parsed
            parsed=$(parse_tokens "$custom_context")
            [[ -z "$parsed" ]] && { print_error "Invalid format. Use suffix k/m (e.g., 500k, 1m)"; continue; }
            local display_ctx
            display_ctx=$(format_tokens "$parsed")
            new_value="${model_to_use}[$display_ctx]"
        elif [[ $opt_choice -eq $remove_opt ]]; then
            [[ -z "$model_to_use" ]] && { print_error "No model name set. Use option $change_name_opt first."; continue; }
            new_value="$model_to_use"
        elif [[ $opt_choice -eq $change_name_opt ]]; then
            read -r -p "Enter new model name (current: ${model_to_use:-(none)}): " new_model_name
            [[ -z "$new_model_name" ]] && { print_warning "No value entered, skipping"; continue; }
            model_to_use="$new_model_name"
            if [[ -n "$current_context_str" ]]; then
                new_value="${model_to_use}[$current_context_str]"
            else
                new_value="$model_to_use"
            fi
        fi

        if [[ -n "$new_value" ]]; then
            update_env "$variant_key" "$new_value"
            print_success "$variant_label updated to: $new_value"
        fi
        echo ""
    done
}

# Change model variants (Fixed layout, always deterministic)
change_model_variants() {
    while true; do
        print_header "═══ Change Model Variants ═══"
        echo ""
        print_info "Current model variants (Guaranteed Fixed Layout):"
        echo ""

        local variant_keys=()
        local variant_labels=()
        local variant_values=()

        while IFS='|' read -r key label val; do
            [[ -z "$key" ]] && continue
            variant_keys+=("$key")
            variant_labels+=("$label")
            variant_values+=("$val")
        done < <(get_all_model_variants)

        for i in "${!variant_keys[@]}"; do
            local display_val="${variant_values[i]}"
            if [[ -z "$display_val" ]]; then
                display_val="(not set)"
            fi
            printf "  ${YELLOW}%2d)${NC} %-30s = ${GREEN}%s${NC}\n" $((i+1)) "${variant_labels[i]} (${variant_keys[i]})" "$display_val"
        done

        local base_count=${#variant_keys[@]}
        local add_custom_opt=$(( base_count + 1 ))
        printf "  ${YELLOW}%2d)${NC} Add/Edit Other Custom Model Variable\n" $add_custom_opt
        printf "  ${RED}%2d)${NC} Back to main menu\n" 0
        echo ""

        read_choice "Select variant [0-$add_custom_opt]: " 0 $add_custom_opt
        local choice=$CHOICE

        [[ $choice -eq 0 ]] && return 0

        if [[ $choice -eq $add_custom_opt ]]; then
            read -r -p "Enter custom model environment variable name (e.g. ANTHROPIC_CUSTOM_MODEL): " custom_var_name
            [[ -z "$custom_var_name" ]] && { print_warning "No variable name entered, skipping"; continue; }
            if [[ "$custom_var_name" != *_MODEL ]]; then
                custom_var_name="${custom_var_name}_MODEL"
            fi
            read -r -p "Enter model value for $custom_var_name: " custom_var_val
            [[ -z "$custom_var_val" ]] && { print_warning "No value entered, skipping"; continue; }
            update_env "$custom_var_name" "$custom_var_val"
            echo ""
            continue
        fi

        local variant_key="${variant_keys[$((choice-1))]}"
        local variant_label="${variant_labels[$((choice-1))]}"
        local current_val="${variant_values[$((choice-1))]}"

        if [[ -n "$current_val" ]]; then
            print_info "Current value: $current_val"
        else
            print_info "Current value: (not set)"
        fi

        read -r -p "Enter new model value (e.g., anthropic/claude-sonnet[500k]): " new_model
        [[ -z "$new_model" ]] && { print_warning "No value entered, skipping"; continue; }

        update_env "$variant_key" "$new_model"
        echo ""
    done
}

# Change Top-Level Model field
change_main_model() {
    print_header "═══ Change Main Model (Top-Level 'model' field) ═══"
    local current
    current=$(get_value "model")
    print_option "Current 'model' field: ${current:-(not set)}"
    echo ""
    print_option "Options:"
    echo "  1) sonnet"
    echo "  2) opus"
    echo "  3) haiku"
    echo "  4) Custom model name"
    echo "  0) Cancel"
    echo ""
    read_choice "Select [0-4]: " 0 4

    case "$CHOICE" in
        1) update_field "model" "sonnet" ;;
        2) update_field "model" "opus" ;;
        3) update_field "model" "haiku" ;;
        4)
            read -r -p "Enter custom model string: " custom_m
            if [[ -n "$custom_m" ]]; then
                update_field "model" "$custom_m"
            fi
            ;;
        0) print_info "Cancelled" ;;
    esac
}

# Main interactive menu
interactive_menu() {
    while true; do
        clear
        show_current_config

        print_header "══════════════════════════════════════════════════════════════"
        print_header "                    CHANGE-CC MENU                             "
        print_header "══════════════════════════════════════════════════════════════"
        echo ""
        print_option "  ${YELLOW}1)${NC} Change Endpoint URL (ANTHROPIC_BASE_URL)"
        print_option "  ${YELLOW}2)${NC} Change Model Context (model[500k], model[1m])"
        print_option "  ${YELLOW}3)${NC} Change Model Variants (Default, Opus, Sonnet, Haiku, etc.)"
        print_option "  ${YELLOW}4)${NC} Change Main Model Field (.model)"
        print_option "  ${YELLOW}5)${NC} Change API Key (ANTHROPIC_AUTH_TOKEN)"
        print_option "  ${YELLOW}6)${NC} Backup Menu (make / restore backup)"
        print_option "  ${RED}0)${NC} Exit"
        echo ""

        read_choice "Select option [0-6]: " 0 6

        case "$CHOICE" in
            1) change_endpoint ;;
            2) change_model_context ;;
            3) change_model_variants ;;
            4) change_main_model ;;
            5) change_auth_token ;;
            6) backup_menu ;;
            0)
                print_info "Goodbye!"
                exit 0
                ;;
        esac
        echo ""
    done
}

# Make a manual backup
make_backup() {
    print_header "═══ Make Backup ═══"
    local claude_dir
    claude_dir="$(dirname "$SETTINGS_FILE")"
    local backup_name="settings.json.backup.$(date +%Y%m%d_%H%M%S)"

    cp "$SETTINGS_FILE" "$claude_dir/$backup_name"
    print_success "Backup created: $claude_dir/$backup_name"

    scan_backups
    echo ""
    print_info "Current backups (${#BACKUPS[@]}):"
    for f in "${BACKUPS[@]}"; do
        printf "       • %s\n" "$(basename "$f" | sed 's/settings.json.backup.//')"
    done
    return 0
}

# List available backups
scan_backups() {
    BACKUPS=()
    local claude_dir
    claude_dir="$(dirname "$SETTINGS_FILE")"
    while IFS= read -r f; do
        [[ -n "$f" ]] && BACKUPS+=("$f")
    done < <(ls -t "$claude_dir/"settings.json.backup.* 2>/dev/null | head -20 || true)
    return 0
}

# Read a menu choice safely
read_choice() {
    local prompt="$1" min="$2" max="$3" input
    while true; do
        read -r -p "$prompt" input
        if ! [[ "$input" =~ ^[0-9]+$ ]]; then
            print_error "Please enter a number between $min and $max"
            continue
        fi
        if (( input >= min && input <= max )); then
            CHOICE="$input"
            return 0
        fi
        print_error "Please enter a number between $min and $max"
    done
}

# Restore from backup
restore_backup() {
    print_header "═══ Restore from Backup ═══"
    scan_backups
    local n=${#BACKUPS[@]}

    if [[ $n -eq 0 ]]; then
        print_warning "No backup files found in ~/.claude/"
    else
        echo "Available backups:"
        for i in "${!BACKUPS[@]}"; do
            local date_str
            date_str=$(basename "${BACKUPS[i]}" | sed 's/settings.json.backup.//')
            printf "  ${YELLOW}%2d)${NC} %s\n" $((i+1)) "$date_str"
        done
    fi
    printf "  ${YELLOW}%2d)${NC} Custom path (use your own backup file)\n" $(( n + 1 ))
    printf "  ${RED}%2d)${NC} Cancel\n" 0
    echo ""

    read_choice "Select [0-$(( n + 1 ))]: " 0 $(( n + 1 ))
    local choice=$CHOICE

    if [[ $choice -eq 0 ]]; then
        print_info "Cancelled"
        return 0
    fi

    local source_file=""
    if [[ $choice -le $n ]]; then
        source_file="${BACKUPS[$((choice-1))]}"
    else
        read -r -p "Enter full path to backup file: " custom_path
        custom_path="${custom_path/#\~/$HOME}"
        if [[ ! -f "$custom_path" ]]; then
            print_error "File not found: $custom_path"
            return 0
        fi
        if ! jq empty "$custom_path" 2>/dev/null; then
            print_error "File is not valid JSON: $custom_path"
            return 0
        fi
        source_file="$custom_path"
    fi

    create_backup
    cp "$source_file" "$SETTINGS_FILE"
    print_success "Restored from: $source_file"
    return 0
}

# Backup management menu
backup_menu() {
    while true; do
        clear
        print_header "╔══════════════════════════════════════════════════════════════╗"
        print_header "║                       BACKUP MENU                            ║"
        print_header "╚══════════════════════════════════════════════════════════════╝"
        echo ""
        scan_backups
        if [[ ${#BACKUPS[@]} -eq 0 ]]; then
            print_warning "No backups found in ~/.claude/"
        else
            print_info "Found ${#BACKUPS[@]} backup(s):"
            for f in "${BACKUPS[@]}"; do
                printf "       • %s\n" "$(basename "$f" | sed 's/settings.json.backup.//')"
            done
        fi
        echo ""
        print_option "  ${YELLOW}1)${NC} Make Backup (save current settings)"
        print_option "  ${YELLOW}2)${NC} Restore Backup (from list or custom path)"
        print_option "  ${RED}0)${NC} Back to Main Menu"
        echo ""

        read_choice "Select option [0-2]: " 0 2
        case "$CHOICE" in
            1) make_backup ;;
            2) restore_backup ;;
            0) return 0 ;;
        esac
        echo ""
    done
}

# Install the script
install_script() {
    mkdir -p "$INSTALL_DIR"
    cp "$0" "$SCRIPT_PATH"
    chmod +x "$SCRIPT_PATH"

    if [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        print_warning "$INSTALL_DIR is not in your PATH"
        print_info "Add this to your ~/.bashrc or ~/.zshrc:"
        echo "  export PATH=\"\$PATH:$INSTALL_DIR\""
    fi

    print_success "Installed $SCRIPT_NAME to $SCRIPT_PATH"
    print_info "You can now run '$SCRIPT_NAME' from anywhere"
}

# Uninstall the script
uninstall_script() {
    if [[ -f "$SCRIPT_PATH" ]]; then
        rm "$SCRIPT_PATH"
        print_success "Uninstalled $SCRIPT_NAME from $SCRIPT_PATH"
    else
        print_warning "$SCRIPT_NAME not found at $SCRIPT_PATH"
    fi

    local claude_dir
    claude_dir="$(dirname "$SETTINGS_FILE")"
    find "$claude_dir" -name "settings.json.backup.*" -mtime +30 -delete 2>/dev/null || true
    print_info "Cleaned up old backup files"
}

# Show help
show_help() {
    cat << EOF
Usage: $SCRIPT_NAME [OPTIONS] [MODEL]

Switch Claude Code models and settings in ~/.claude/settings.json

OPTIONS:
    -h, --help       Show this help message
    -l, --list       Show current configuration
    -i, --install    Install the change-cc command globally
    -u, --uninstall  Uninstall the change-cc command

EXAMPLES:
    $SCRIPT_NAME                              # Interactive menu
    $SCRIPT_NAME anthropic/claude-sonnet[1m]  # Set default model with context directly
    $SCRIPT_NAME --list                       # Show current configuration
    $SCRIPT_NAME --install                    # Install globally
    $SCRIPT_NAME --uninstall                  # Remove global command

FEATURES:
    • Fixed layout parsing (no swapped keys or shifted indexes)
    • Interactive menu for all settings
    • Change endpoint URL (ANTHROPIC_BASE_URL)
    • Change main model field (.model)
    • Change all model variants (Default, Opus, Sonnet, Haiku, Fable, Small/Fast, Custom)
    • Change API key / Auth token (ANTHROPIC_AUTH_TOKEN)
    • Context window suffix management ([500k], [1m], etc.)
    • Backup and restore functionality
    • Global install/uninstall

EOF
}

# Main function
main() {
    check_jq
    check_settings_file

    case "${1:-}" in
        -h|--help)
            show_help
            ;;
        -l|--list)
            show_current_config
            ;;
        -i|--install)
            install_script
            ;;
        -u|--uninstall)
            uninstall_script
            ;;
        "")
            interactive_menu
            ;;
        *)
            # Direct model setting - update ANTHROPIC_MODEL env var
            update_env "ANTHROPIC_MODEL" "$1"
            ;;
    esac
}

# Run main
main "$@"
